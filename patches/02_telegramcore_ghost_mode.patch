--- a/submodules/TelegramCore/Sources/State/ManagedAccountSynchronization.swift
+++ b/submodules/TelegramCore/Sources/State/ManagedAccountSynchronization.swift
@@ -410,6 +410,18 @@ extension ManagedAccountSynchronization {
     private static func processEditMessageUpdate(transaction: PostboxTransaction, rawMessage: Api.Message) {
+        if AyuSettings.shared.isEditHistoryEnabled {
+            let messageId = rawMessage.id
+            let peerId = rawMessage.peerId
+            if let existingMessage = transaction.getMessage(MessageId(peerId: peerId, namespace: 0, id: messageId)) {
+                AyuEditHistoryStorage.shared.recordEdit(
+                    peerId: peerId.toInt64(),
+                    messageId: messageId,
+                    previousText: existingMessage.text,
+                    editTimestamp: Int32(Date().timeIntervalSince1970)
+                )
+            }
+        }
         transaction.applyMessageEdit(rawMessage)
     }
 }
